 "messages": {
  "stage_locked": "Мазур: «Спершу закінчимо з тим, що маємо. Усе по порядку».",
  "already": "Зоя: «Це ми вже отримали — подивіться в справі».",
  "repeat": "Людина вже все сказала. Нових запитань — без нових фактів — вона слухати не буде.",
  "unknown_person": "Мазур: «Такої людини в цій справі я не пригадую. Перевірте ім'я».",
  "INT": "Мазур: «Розмова нічого не дала: людина або не знає, або не хоче говорити».",
  "FAX": "Зоя: «Факс пішов, але відповіли, що таких даних у них нема».",
  "OGL": "Мазур: «Оглянули — нічого вартого уваги».",
  "ARCH": "Зоя: «В архіві й підшивках нічого не знайшла».",
  "TRANS": "Лілія Борисівна: «Цей документ і так українською — або його в нас нема».",
  "PLOT": "Мазур: «Нема з чого прокладати — потрібні позиції з часом».",
  "fax_umc_early": "Зоя: «UMC деталізацію дає лише абоненту. Можна попросити страховика вимагати її від «Акватрейду», але Мазур каже: спершу маяк».",
  "fax_stage2": "Мазур: «Це зайве. Спершу з'ясуйте, що світило з коси тієї ночі, тоді візьмемося за екіпаж, судно й гроші».",
  "r_crew_wait": "Мазур: «Екіпаж зберемо в Одесі завтра. Спершу — маяк».",
  "ogl_c14_early": "Мазур: «Судно ще гойдає, огляд — коли сяде щільно. Спершу маяк».",
  "ogl_d06_early": "Мазур: «Шлюпка лежить на березі під приливом. Подивимося, коли знатимемо, що шукати».",
  "ogl_e01_early": "Мазур: «Ми вже оглядали маяк. Нічого нового там поки що не з'явилося».",
  "ogl_e02_early": "Мазур: «У хату нас не запрошували. Поки що».",
  "fax_d04_early": "Зоя: «Укртелеком без причини розшифровки не дасть. Нам треба знати, чий номер і навіщо».",
  "fax_d05_early": "Зоя: «Дьомін відповів: «Висновок готується. Справа закрита як нещасний випадок»».",
  "fax_e03_early": "Зоя: «Дьомін відповів: «Підстав для експертизи немає»».",
  "fax_e07_early": "Зоя: «Дубовик відписав: особові справи — лише за запитом суду чи прокуратури».",
  "r_boyko": "Бойко: «Усе сказав. Є протест капітана, його й читайте».",
  "r_havryliuk": "Гаврилюк: «Без адвоката не розмовлятиму. Усе написано в протоколі — читайте».",
  "r_tkach": "Ткач: «Я на баку був, нічого не бачив, курсів не знаю».",
  "r_oksana": "Оксана: «Я нічого не знаю. Дитину не чіпайте».",
  "r_martyniuk": "Мартинюк: «Я своє сказав. Маяк горів».",
  "r_kravets": "Кравець: «Та що ви до мене? Я вам усе розказав»."
